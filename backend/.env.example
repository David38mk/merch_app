# Copy to .env and adjust. Matches docker-compose.yml defaults.
DATABASE_URL=postgresql://mhc:mhc_dev_password@localhost:5432/myhappinessclub

# JWT signing — generate a real one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-me

# CORS — the Vite dev server origin. Also used to build reset/verify links.
FRONTEND_ORIGIN=http://localhost:5173

# DEBUG=true returns the dev reset/verify link in the API response (email is stubbed).
# Turn OFF in production.
DEBUG=true

# ── Google Sign-In ────────────────────────────────────────────
# Paste your Google OAuth *Web* Client ID to enable the Google button.
# Empty = Google sign-in stays disabled.
GOOGLE_CLIENT_ID=

# ── Email verification ────────────────────────────────────────
# true = users must verify their email before login. Default off (fewest steps).
EMAIL_VERIFICATION_ENABLED=false
