# ── Secrets / env ─────────────────────────────
.env
.env.local
.env.*.local
.env.production
*/.env
!*/.env.example

# ── Python / backend ──────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Locally-stored uploads (🔌 storage seam — real files live on a CDN in prod)
backend/uploads/

# ── Node / frontend ───────────────────────────
node_modules/
dist/
.vite/
*.tsbuildinfo

# ── Python test coverage ──────────────────────
.coverage
coverage.xml
htmlcov/
coverage/

# ── Editors / IDEs ────────────────────────────
.vscode/
# Local debug configs (explicit — already covered by .vscode/ above)
.vscode/launch.json
.vscode/tasks.json
.idea/
*.swp
*~

# ── Logs / misc ───────────────────────────────
npm-debug.log*
*.log

# ── OS junk ───────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

